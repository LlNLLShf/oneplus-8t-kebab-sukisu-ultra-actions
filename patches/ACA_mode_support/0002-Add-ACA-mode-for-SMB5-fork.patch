From 14d955efbdb0538190a029e8cd7d56d58e169862 Mon Sep 17 00:00:00 2001
From: GitHub Actions <actions@github.com>
Date: Wed, 30 Sep 2026 02:44:07 +0800
Subject: [PATCH] Add ACA mode for SMB5 fork

---
 .../oplus/charger_ic/oplus_battery_msm8250.c  | 25 +++++++++++++++++++
 1 file changed, 25 insertions(+)

diff --git a/drivers/power/oplus/charger_ic/oplus_battery_msm8250.c b/drivers/power/oplus/charger_ic/oplus_battery_msm8250.c
index f197cc395d08..d9d68ac41f5a 100644
--- a/drivers/power/oplus/charger_ic/oplus_battery_msm8250.c
+++ b/drivers/power/oplus/charger_ic/oplus_battery_msm8250.c
@@ -338,6 +338,10 @@ static struct smb_params smb5_pm8150b_params = {
 static int __debug_mask = PR_MISC | PR_OTG | PR_INTERRUPT | PR_REGISTER;
 module_param_named(debug_mask, __debug_mask, int, 0600);
 
+static bool aca_mode = false;
+module_param(aca_mode, bool, 0644);
+MODULE_PARM_DESC(aca_mode, "Enable ACA mode (Host + External Charging)");
+
 #else
 static int __debug_mask;
 #endif
@@ -1187,6 +1191,16 @@ static void smblib_notify_usb_host(struct smb_charger *chg, bool enable)
 	int rc = 0;
 
 	if (enable) {
+		if (aca_mode && chg->iio.mid_chan) {
+			union power_supply_propval vbus_voltage = {0, };
+			iio_read_channel_processed(chg->iio.mid_chan, &vbus_voltage.intval);
+			if (vbus_voltage.intval > 4500000) {
+				smblib_err(chg, "ACA mode: External VBUS (%d uV) detected, skipping internal OTG boost\n",
+						   vbus_voltage.intval);
+				goto notify_extcon;
+			}
+		}
+
 		smblib_dbg(chg, PR_OTG, "enabling VBUS in OTG mode\n");
 		rc = smblib_masked_write(chg, DCDC_CMD_OTG_REG, OTG_EN_BIT, OTG_EN_BIT);
 		if (rc < 0) {
@@ -1194,6 +1208,7 @@ static void smblib_notify_usb_host(struct smb_charger *chg, bool enable)
 			return;
 		}
 
+		notify_extcon:
 		smblib_notify_extcon_props(chg, EXTCON_USB_HOST);
 	} else {
 		smblib_dbg(chg, PR_OTG, "disabling VBUS in OTG mode\n");
@@ -4279,6 +4294,16 @@ int smblib_get_prop_usb_online(struct smb_charger *chg, union power_supply_propv
 	}
 #endif /*OPLUS_FEATURE_CHG_BASIC*/
 
+	if (aca_mode && chg->otg_present && chg->iio.mid_chan) {
+		union power_supply_propval vbus_voltage = {0, };
+		iio_read_channel_processed(chg->iio.mid_chan, &vbus_voltage.intval);
+		if (vbus_voltage.intval > 4500000) {
+			val->intval = 1;
+			return 0;
+		}
+	}
+
+
 	if (get_client_vote_locked(chg->usb_icl_votable, USER_VOTER) == 0) {
 		val->intval = false;
 #ifdef OPLUS_FEATURE_CHG_BASIC
-- 
2.54.0

